root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{json,yml,yaml,ts,tsx}]
indent_style = space
indent_size = 2

[*.cs]
indent_style = space
indent_size = 4

# Migrações aplicadas são código gerado e imutável; não altere seu conteúdo histórico.
[src/Foundation/Vinx.Erp.Foundation/Persistence/Migrations/**/*.cs]
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.IDE0300.severity = none
