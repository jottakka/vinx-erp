{
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:real-e2e": "node scripts/run-real-e2e.mjs",
    "tools:check": "node --version && dotnet --version && docker version --format '{{.Server.Version}}' && supabase --version",
    "supabase": "supabase",
    "test:no-direct-supabase": "bash -c 'grep -R -n -i -E \"@supabase|supabase|/auth/v1|VITE_SUPABASE\" apps/web/src; status=$?; test \"$status\" -eq 1'",
    "test:projectmem-pilot": "node --test tests/projectmem-pilot.test.mjs"
  },
  "devDependencies": {
    "supabase": "^2.119.0"
  }
}
